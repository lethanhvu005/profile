# Local development. Copy to .env. Hosting environment variables take precedence.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Leave empty locally to keep SQLite and local image files.
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set these on Render for initial admin creation. Never commit actual values.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
SEED_DEMO=0
